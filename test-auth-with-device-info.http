Content-Type: application/json

{
  "emailOuTelephone": "admin@Prosoc.cd",
  "motDePasse": "Admin",
  "fcmToken": "aB3x9PqN7mK2wL5hC8tR1vJ4fD6gS0eM9uY3iP7bT2qX5nW8jL1",
