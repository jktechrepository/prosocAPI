# ============================================
# Test 2: VIRTUAL_ACCOUNT avec montant trop élevé
# ============================================
POST {{baseUrl}}/api/Adhesion/with-affilie
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "Nom": "Test",
  "Prenom": "High",
  "Postnom": "Amount",
  "DateNaissance": "1990-01-01",
  "Telephone": "0123456780",
  "EmailAffilie": "test.high@prosoc.cd",
  "ProvinceResidence": "Kinshasa",
  "CommuneResidence": "Lemba",
  "QuartierResidence": "Salongo",
  "AvenueResidence": "ByPass",
  "NumeroResidence": "124",
  "StatutDossier": "COMPLET",
  "TypeAdhesionId": 1,
  "AgentId": 1,
  "AffilieStatut": true,
  "AdhesionStatut": true,
  "Collectes": [
    {
      "TypeCollecte": "Souscription",
      "Montant": 999999,
      "Mois": 3,
      "Annee": 2026,
      "ModePaiement": "VIRTUAL_ACCOUNT",
      "DeviseId": 1,
      "Statut": true,
      "Souscription": {
        "PrestationId": 1
      }
    }
  ],
  "Dependants": [],
  "Antecedants": []
}

> {%
client.test("VIRTUAL_ACCOUNT - Montant trop élevé", function() {
    client.assert(response.status === 400, "Status should be 400 (validation error)");
    
    const responseBody = response.body;
    if (responseBody.error && responseBody.error.message) {
        const errorMessage = responseBody.error.message;
        if (errorMessage.includes("Solde virtuel insuffisant")) {
            console.log("✅ Test 2: VIRTUAL_ACCOUNT - Validation solde insuffisant - SUCCÈS");
        } else if (errorMessage.includes("Aucun wallet virtuel")) {
            console.log("✅ Test 2: VIRTUAL_ACCOUNT - Validation wallet inexistant - SUCCÈS");
        } else {
            console.log("⚠️ Test 2: Erreur de validation différente:", errorMessage);
        }
    } else {
        console.log("❌ Test 2: Erreur inattendue");
    }
});
%}

