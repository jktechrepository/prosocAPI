# ============================================
# Test 5: Vérifier le solde d'un agent
# ============================================
GET {{baseUrl}}/api/WalletVirtuelAgent/solde/1
Authorization: Bearer {{token}}

> {%
client.test("Vérification solde wallet virtuel", function() {
    if (response.status === 200) {
        const solde = response.body;
        console.log("💰 Solde wallet virtuel agent 1:", solde);
        console.log("✅ Test 5: Vérification solde - SUCCÈS");
    } else if (response.status === 404) {
        console.log("⚠️ Test 5: Wallet virtuel non trouvé pour l'agent 1");
    } else {
        console.log("❌ Test 5: Erreur lors de la vérification du solde");
    }
});
%}

