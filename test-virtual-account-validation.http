# ============================================
# Test 3: VIRTUAL_ACCOUNT sans wallet virtuel (agent sans wallet)
# ============================================
POST {{baseUrl}}/api/Adhesion/with-affilie
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "Nom": "Test",
  "Prenom": "No",
  "Postnom": "Wallet",
  "DateNaissance": "1990-01-01",
  "Telephone": "0123456781",
  "EmailAffilie": "test.nowallet@prosoc.cd",
  "ProvinceResidence": "Kinshasa",
  "CommuneResidence": "Lemba",
  "QuartierResidence": "Salongo",
  "AvenueResidence": "ByPass",
  "NumeroResidence": "125",
  "StatutDossier": "COMPLET",
  "TypeAdhesionId": 1,
  "AgentId": 999, // Agent qui probablement n'existe pas ou n'a pas de wallet
  "AffilieStatut": true,
  "AdhesionStatut": true,
  "Collectes": [
    {
      "TypeCollecte": "Souscription",
      "Montant": 50,
      "Mois": 3,
      "Annee": 2026,
      "ModePaiement": "VIRTUAL_ACCOUNT",
      "DeviseId": 1,
      "Statut": true,
      "Souscription": {
        "PrestationId": 1
      }
    }
  ],
  "Dependants": [],
  "Antecedants": []
}

> {%
client.test("VIRTUAL_ACCOUNT - Agent sans wallet", function() {
    client.assert(response.status === 400, "Status should be 400 (validation error)");
    
    const responseBody = response.body;
    if (responseBody.error && responseBody.error.message) {
        const errorMessage = responseBody.error.message;
        if (errorMessage.includes("Aucun wallet virtuel") || errorMessage.includes("non trouvé")) {
            console.log("✅ Test 3: VIRTUAL_ACCOUNT - Validation wallet inexistant - SUCCÈS");
        } else {
            console.log("⚠️ Test 3: Erreur différente:", errorMessage);
        }
    } else {
        console.log("❌ Test 3: Erreur inattendue");
    }
});
%}

