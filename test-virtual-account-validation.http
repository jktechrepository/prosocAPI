### 🧪 TEST DE VALIDATION VIRTUAL ACCOUNT - SOLDE VIRTUEL

# ============================================
# Test 1: VIRTUAL_ACCOUNT avec solde suffisant
# ============================================
POST {{baseUrl}}/api/Adhesion/with-affilie
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "Nom": "Test",
  "Prenom": "Virtual",
  "Postnom": "Account",
  "DateNaissance": "1990-01-01",
  "Telephone": "0123456789",
  "EmailAffilie": "test.virtual@prosoc.cd",
  "ProvinceResidence": "Kinshasa",
  "CommuneResidence": "Lemba",
  "QuartierResidence": "Salongo",
  "AvenueResidence": "ByPass",
  "NumeroResidence": "123",
  "StatutDossier": "COMPLET",
  "TypeAdhesionId": 1,
  "AgentId": 1,
  "AffilieStatut": true,
  "AdhesionStatut": true,
  "Collectes": [
    {
      "TypeCollecte": "Souscription",
      "Montant": 50,
      "Mois": 3,
      "Annee": 2026,
      "ModePaiement": "VIRTUAL_ACCOUNT",
      "DeviseId": 1,
      "Statut": true,
      "Souscription": {
        "PrestationId": 1
      }
    }
  ],
  "Dependants": [],
  "Antecedants": []
}

> {%
client.test("VIRTUAL_ACCOUNT - Solde suffisant", function() {
    client.assert(response.status === 201 || response.status === 400, "Status should be 201 (success) or 400 (validation error)");
    
    if (response.status === 201) {
        client.assert(response.body.success !== false, "Adhésion should be created successfully");
        console.log("✅ Test 1: VIRTUAL_ACCOUNT avec solde suffisant - SUCCÈS");
    } else {
        const responseBody = response.body;
        if (responseBody.error && responseBody.error.message && responseBody.error.message.includes("Solde virtuel insuffisant")) {
            console.log("⚠️ Test 1: VIRTUAL_ACCOUNT - Solde insuffisant (normal si wallet vide)");
        } else if (responseBody.error && responseBody.error.message && responseBody.error.message.includes("Aucun wallet virtuel")) {
            console.log("⚠️ Test 1: VIRTUAL_ACCOUNT - Wallet virtuel inexistant (normal pour premier test)");
        } else {
            console.log("❌ Test 1: Erreur inattendue:", responseBody.error?.message || responseBody.message);
        }
    }
});
%}

