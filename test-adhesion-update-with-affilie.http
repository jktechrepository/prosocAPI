### Test API Adhesion UpdateWithAffilieAsync

# 1. Créer une adhésion de test d'abord (si nécessaire)
POST {{baseUrl}}/api/adhesion/create-with-affilie
Content-Type: application/json

{
  "affilie": {
    "nom": "KABONGO",
    "prenom": "Jean",
    "dateNaissance": "1990-05-15",
    "telephone": "+243812345678",
    "provinceResidence": "Kinshasa",
    "communeResidence": "Lingwala",
    "quartierResidence": "Kintambo",
    "avenueResidence": "ByPass",
    "numeroResidence": "123",
    "communeActivite": "Lingwala",
    "quartierActivite": "Kintambo",
    "avenueActivite": "ByPass",
    "numeroActivite": "123"
