### 📊 VÉRIFICATIONS & DEBUG
### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

### Vérifier les devices du tuteur
# @name verifierDevicesTuteur
GET {{baseUrl}}/api/UserDevice/utilisateur/{{idUtilisateurTuteur}}
Authorization: Bearer {{tuteurToken}}

### Vérifier les paiements de l'élève
# @name verifierPaiementsEleve
GET {{baseUrl}}/api/Paiement/eleve/{{idEleve}}
Authorization: Bearer {{token}}

### Vérifier tous les paiements de l'école
# @name verifierPaiementsEcole
GET {{baseUrl}}/api/Paiement/ecole/1
Authorization: Bearer {{token}}

### Envoyer une notification de test directement au tuteur
# @name testNotificationDirecte
POST {{baseUrl}}/api/NotificationPush/utilisateur/{{idUtilisateurTuteur}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "titre": "💰 Test Notification Paiement",
  "corps": "Notification de test pour vérifier les paiements",
  "donnees": {
    "type": "TEST_PAIEMENT",
    "timestamp": "2025-10-27T12:00:00"
  }
}

### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
### 🧪 TESTS AVEC DES DONNÉES EXISTANTES (IDs connus)
### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

### Scénario: Élève existant avec tuteur et device déjà enregistrés
POST {{baseUrl}}/api/Paiement
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "montant": 100.00,
  "devise": "USD",
  "modePaiement": "Mobile Money",
  "statutPaiement": "Confirme",
  "referenceTransaction": "MM-TEST-001",
  "commentaire": "Test paiement avec élève existant",
  "idFrais": 1,
  "idEleve": 1,
  "idUtilisateur": 1
}

### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
### 🎯 RÉSULTATS ATTENDUS
### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
###
### ✅ SUCCÈS SI:
### 1. Le paiement retourne HTTP 201 Created
### 2. Les logs montrent: "✅ Notification paiement envoyée au tuteur..."
### 3. Le device du tuteur reçoit la notification push
### 4. La notification contient:
###    PAIEMENT CONFIRMÉ:
###    - Titre: "✅ Paiement [NomEleve]"
###    - Corps: "Montant: 150.00 USD\nType: Frais de scolarité\n..."
###
###    PAIEMENT EN ATTENTE:
###    - Titre: "⏳ Paiement [NomEleve]"
###    - Corps: "... ⏳ Paiement en cours de validation"
###
###    PAIEMENT ÉCHOUÉ:
###    - Titre: "❌ Paiement [NomEleve]"
###    - Corps: "... ❌ Paiement échoué - Veuillez réessayer"
###
### 5. Data contient: type=PAIEMENT_ELEVE, idPaiement, montant, etc.
###
### ⚠️ CAS GÉRÉS SANS ERREUR:
### 1. Élève sans tuteur lié → Paiement OK, pas de notification
### 2. Tuteur sans compte utilisateur → Paiement OK, log info
### 3. Tuteur sans device actif → Paiement OK, log warning
### 4. Erreur Firebase → Paiement OK, log error (ne bloque pas)
###
### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

