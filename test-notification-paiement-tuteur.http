### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
### 🎯 TEST COMPLET: NOTIFICATION PUSH AU TUTEUR LORS DU PAIEMENT ÉLÈVE
### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
###
### 📋 SCÉNARIO DE TEST:
### 1. Créer/utiliser un tuteur existant
### 2. Créer/utiliser un compte utilisateur pour le tuteur
### 3. Enregistrer un device (token FCM) pour le tuteur
### 4. Créer/utiliser un élève lié au tuteur
### 5. Créer/utiliser un frais
### 6. Effectuer un paiement pour l'élève
### 7. ✅ Vérifier que le tuteur reçoit la notification push
###
### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

@baseUrl = https://localhost:7012
@token = {{authentification.response.body.token}}

### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
### ÉTAPE 0: AUTHENTIFICATION (Super-Admin ou Directeur)
### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# @name authentification
POST {{baseUrl}}/api/Utilisateur/authentifier
Content-Type: application/json

{
  "username": "admin",
  "motDePasse": "Admin@2025"
}

### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
