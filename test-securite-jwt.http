### ✅ Login avec Super-Admin (endpoint public)
POST https://localhost:7102/api/Utilisateur/authentifier
Content-Type: application/json

{
  "emailOuTelephone": "superadmin@Prosoc.cd",
  "motDePasse": "Super-Admin"
}

### Résultat attendu : 200 OK avec token JWT
### Copiez le token retourné dans "accessToken"

### ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
### 3️⃣ TESTS AVEC TOKEN VALIDE (doit réussir avec 200 OK)
