### Test API Affilie avec PhotoUrl

# 1. Créer un affilié avec PhotoUrl
POST {{baseUrl}}/api/affilie
Content-Type: application/json

{
  "codeAdhesion": "AFF-001",
  "nom": "KABONGO",
  "prenom": "Jean Pierre",
  "nomComplet": "Jean Pierre KABONGO",
  "dateNaissance": "1990-05-15T00:00:00Z",
  "telephone": "+243812345678",
  "postnom": "Michel",
  "provinceResidence": "Kinshasa",
  "communeResidence": "Lemba",
  "quartierResidence": "Salongo",
  "avenueResidence": "By Pass",
  "numeroResidence": "123",
  "communeActivite": "Lemba",
  "quartierActivite": "Salongo",
  "avenueActivite": "By Pass",
  "numeroActivite": "456",
  "photoUrl": "https://example.com/photos/jean-pierre-kabongo.jpg",
  "statut": true
}

